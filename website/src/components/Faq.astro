---
// FAQ — GameHub parity accordion.
const faqs = [
  {
    q: "WHAT IS SAMBAS3?",
    a: "A native Android UI/launcher for the RPCSX PS3 emulator core. SambaS3 handles the library, settings, firmware, drivers, controllers, overlays and save states — the RPCSX .so does the actual emulation and is loaded at runtime.",
  },
  {
    q: "IS IT FREE?",
    a: "Yes. SambaS3 is GPLv2 open source. There are no paid features, no accounts and no ads — just APKs (standard + Play Store flavors) built from the public repo.",
  },
  {
    q: "WHERE DO GAMES AND FIRMWARE COME FROM?",
    a: "Nowhere in the app — you bring your own. Dump PS3UPDAT.PUP and your discs from hardware you own, then import them with the + tile. Do not ask for links on GitHub or Discord; piracy is not permitted there.",
  },
  {
    q: "WHICH DEVICES RUN IT BEST?",
    a: "Android 10+ with a Vulkan-capable flagship SoC and 8 GB+ RAM. Snapdragon 8-series + a matching Turnip driver gives the best results. x86_64 devices are supported but arm64 is the primary target.",
  },
  {
    q: "DO I NEED A CONTROLLER?",
    a: "No — but the whole UI is controller-first: D-pad moves, Cross confirms, Circle goes back, Triangle opens game info, LB/RB switch tabs. USB and Bluetooth pads work, with a test screen and per-game mapping, plus a fully editable touch overlay when you play handheld.",
  },
  {
    q: "STANDARD VS PLAY STORE BUILD?",
    a: "Standard (default) lets you import or download external GPU drivers. Play Store bundles tested Turnip drivers in assets and disables external imports. Pick standard if you like tuning drivers per game.",
  },
  {
    q: "WHY WON'T MY GAME BOOT?",
    a: "Usual suspects: missing/incompatible firmware, wrong driver for the title, too-aggressive global settings, or a bad dump. Check the built-in log monitor and crash history, try per-game defaults, and ask on Discord with logs and your device/driver versions.",
  },
  {
    q: "IS IT AFFILIATED WITH SONY OR RPCSX?",
    a: "No. SambaS3 is an independent open-source frontend that loads the RPCSX core at runtime. PlayStation and PS3 are trademarks of Sony Interactive Entertainment. This project is not affiliated with or endorsed by Sony.",
  },
];
---

<section id="faq" class="mx-auto max-w-4xl scroll-mt-20 px-4 py-20 sm:px-6 lg:py-28">
  <div class="reveal text-center">
    <p class="font-mono2 text-[11px] tracking-[0.28em] text-gold">08 — FAQ</p>
    <h2 data-glitch class="mt-3 font-heading text-3xl font-bold tracking-wide text-cream sm:text-4xl">COMMON QUESTIONS</h2>
  </div>
  <div class="mt-10 grid gap-3">
    {faqs.map((f, i) => (
      <div class="faq-item reveal rounded-lg border border-white/8 bg-surface" data-open={i === 0 ? "true" : "false"}>
        <button class="faq-toggle flex w-full items-center justify-between gap-4 px-5 py-4 text-left" aria-expanded={i === 0 ? "true" : "false"}>
          <span class="font-heading text-[15px] font-bold tracking-[0.1em] text-cream">{f.q}</span>
          <span class="faq-chevron shrink-0 font-heading text-lg text-gold" aria-hidden="true">▾</span>
        </button>
        <div class="faq-answer">
          <div class="overflow-hidden">
            <p class="px-5 pb-5 font-body leading-relaxed text-warm">{f.a}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll(".faq-item").forEach((item) => {
    const btn = item.querySelector(".faq-toggle");
    btn?.addEventListener("click", () => {
      const open = item.getAttribute("data-open") === "true";
      document.querySelectorAll(".faq-item").forEach((o) => {
        o.setAttribute("data-open", "false");
        o.querySelector(".faq-toggle")?.setAttribute("aria-expanded", "false");
      });
      item.setAttribute("data-open", String(!open));
      btn.setAttribute("aria-expanded", String(!open));
    });
  });
</script>
