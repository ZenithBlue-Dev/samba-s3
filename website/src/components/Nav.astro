---
// Sticky top nav — GameHub parity: logo left, section links center, download right.
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/8 bg-abyss/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6" aria-label="Primary">
    <a href="#top" class="flex items-center gap-3">
      <img src="icon.png" alt="SambaS3 icon" class="h-9 w-9 rounded-md border border-gold/40" width="36" height="36" />
      <span class="font-display text-[13px] tracking-[0.18em] text-gold">SAMBA<span class="text-cream">S3</span></span>
      <span class="hidden rounded border border-gold/30 bg-gold-muted px-1.5 py-0.5 font-mono2 text-[10px] tracking-widest text-gold sm:inline">PS3 · ANDROID</span>
    </a>
    <div class="hidden items-center gap-7 font-heading text-[13px] font-semibold tracking-[0.14em] text-warm lg:flex">
      <a href="#features" class="transition hover:text-gold">FEATURES</a>
      <a href="#showcase" class="transition hover:text-gold">APP TOUR</a>
      <a href="#setup" class="transition hover:text-gold">SETUP</a>
      <a href="#library" class="transition hover:text-gold">LIBRARY</a>
      <a href="#games" class="transition hover:text-gold">GAMES</a>
      <a href="#specs" class="transition hover:text-gold">SPECS</a>
      <a href="#faq" class="transition hover:text-gold">FAQ</a>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/zenithblue-oss/samba-s3"
        class="hidden rounded px-3 py-2 font-heading text-[13px] font-semibold tracking-[0.12em] text-warm transition hover:bg-white/5 hover:text-cream sm:block"
        aria-label="GitHub"
      >GITHUB</a>
      <a
        href="https://discord.gg/t6dzA4wUdG"
        class="hidden rounded px-3 py-2 font-heading text-[13px] font-semibold tracking-[0.12em] text-warm transition hover:bg-white/5 hover:text-cream sm:block"
      >DISCORD</a>
      <a
        href="#download"
        class="btn-gold rounded bg-gold px-4 py-2 font-heading text-[13px] font-bold tracking-[0.12em] text-abyss transition hover:bg-focus"
      >DOWNLOAD</a>
      <button
        id="menu-btn"
        class="rounded border border-white/10 p-2 text-cream lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="hidden border-t border-white/8 bg-surface px-4 py-3 lg:hidden">
    <div class="grid gap-1 font-heading text-sm font-semibold tracking-[0.14em]">
      {["FEATURES|#features","APP TOUR|#showcase","SETUP|#setup","LIBRARY|#library","GAMES|#games","SPECS|#specs","DOWNLOAD|#download","FAQ|#faq"].map((l) => {
        const [label, href] = l.split("|");
        return <a href={href} class="rounded px-3 py-2.5 text-warm transition hover:bg-white/5 hover:text-gold">{label}</a>;
      })}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(!!open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    })
  );
</script>
